{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__path=:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "/api/index?__path=media/:path*"
    },
    {
      "source": "/webhook",
      "destination": "/api/index?__path=webhook"
    },
    {
      "source": "/auth/facebook/callback",
      "destination": "/api/index?__path=auth/facebook/callback"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/delete-data",
      "destination": "/delete-data.html"
    }
  ]
}
