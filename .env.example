# Copy this file to ".env" (same folder) and fill it in. Never share the .env file.
# Lines starting with # are comments.

# --- Facebook / Meta (see SETUP-META.md). Leave empty to use the software in test mode only.
APP_ID=
APP_SECRET=
# Use the newest Graph API version shown in your Meta app dashboard, for example v23.0
GRAPH_VERSION=
# The public https address of this software (no slash at the end). Needed for login, webhooks and product photos.
BASE_URL=
# Any long random text you invent. The same text goes into the Meta webhook settings.
VERIFY_TOKEN=
# Only if your Meta app uses "Facebook Login for Business": the configuration ID. Otherwise leave empty.
CONFIG_ID=

# --- Security (optional: if empty, random keys are created in the data folder on first run)
# Key you type to open the dashboard (at least 12 characters).
ADMIN_KEY=
# Key used to encrypt the saved Facebook Page tokens. Keep a copy: without it you must reconnect your Pages.
SECRET_KEY=

# --- Network
PORT=3000
# 127.0.0.1 = only this computer. Use 0.0.0.0 only behind an https reverse proxy.
HOST=127.0.0.1
